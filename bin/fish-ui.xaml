<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSH 小鱼" Width="380" Height="432"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <!-- 主蓝色渐变 -->
    <LinearGradientBrush x:Key="BodyBrush" StartPoint="0.12,0.05" EndPoint="0.95,1">
      <GradientStop Color="#9DB1FF" Offset="0"/>
      <GradientStop Color="#5D7BFB" Offset="0.42"/>
      <GradientStop Color="#4D6BFE" Offset="0.72"/>
      <GradientStop Color="#3550E8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TailBrush" StartPoint="1,0.5" EndPoint="0,0.5">
      <GradientStop Color="#6E88FA" Offset="0"/>
      <GradientStop Color="#3550E8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FinBrush" StartPoint="0.2,0" EndPoint="0.8,1">
      <GradientStop Color="#A9BAFF" Offset="0"/>
      <GradientStop Color="#5D7BFB" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BarBrush" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#7C93FF" Offset="0"/>
      <GradientStop Color="#A9BAFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BarDoneBrush" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#3DDC97" Offset="0"/>
      <GradientStop Color="#8CF0C6" Offset="1"/>
    </LinearGradientBrush>

    <DropShadowEffect x:Key="FishShadow" Color="#08101F" BlurRadius="26" ShadowDepth="1" Opacity="0.5"/>
    <DropShadowEffect x:Key="BubbleShadow" Color="#04070F" BlurRadius="26" ShadowDepth="3" Opacity="0.5" Direction="270"/>
    <BlurEffect x:Key="CheekBlur" Radius="6"/>

    <!-- 待机漂浮 -->
    <Storyboard x:Key="Bob">
      <DoubleAnimation Storyboard.TargetName="FishBob" Storyboard.TargetProperty="Y"
                       From="0" To="-7" Duration="0:0:2.2" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>

    <!-- 尾巴摆动 -->
    <Storyboard x:Key="TailWag">
      <DoubleAnimation Storyboard.TargetName="TailRotate" Storyboard.TargetProperty="Angle"
                       From="-7" To="7" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>

    <!-- 侧鳍扇动 -->
    <Storyboard x:Key="FinFlap">
      <DoubleAnimation Storyboard.TargetName="FinRotate" Storyboard.TargetProperty="Angle"
                       From="-8" To="10" Duration="0:0:2.1" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>

    <!-- 眨眼 -->
    <Storyboard x:Key="Blink">
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EyeScaleL" Storyboard.TargetProperty="ScaleY">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.07" Value="0.08"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.17" Value="1"/>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EyeScaleR" Storyboard.TargetProperty="ScaleY">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.07" Value="0.08"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.17" Value="1"/>
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- 完成时跳一下 -->
    <Storyboard x:Key="Celebrate">
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="JumpY" Storyboard.TargetProperty="Y">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
        <EasingDoubleKeyFrame KeyTime="0:0:0.20" Value="-36">
          <EasingDoubleKeyFrame.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
        <EasingDoubleKeyFrame KeyTime="0:0:0.46" Value="0">
          <EasingDoubleKeyFrame.EasingFunction><BounceEase Bounces="1" Bounciness="2" EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
        <EasingDoubleKeyFrame KeyTime="0:0:0.62" Value="-15"/>
        <EasingDoubleKeyFrame KeyTime="0:0:0.82" Value="0">
          <EasingDoubleKeyFrame.EasingFunction><BounceEase Bounces="1" Bounciness="2" EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="JumpScale" Storyboard.TargetProperty="ScaleX">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1.06"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.46" Value="0.97"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.82" Value="1"/>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="JumpScale" Storyboard.TargetProperty="ScaleY">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1.06"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.46" Value="0.97"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.82" Value="1"/>
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- 星光迸发 -->
    <Storyboard x:Key="Sparkle">
      <DoubleAnimation Storyboard.TargetName="SparkleLayer" Storyboard.TargetProperty="Opacity"
                       From="0" To="1" Duration="0:0:0.15" AutoReverse="True" BeginTime="0:0:0.12"/>
      <DoubleAnimation Storyboard.TargetName="SparkleScale" Storyboard.TargetProperty="ScaleX"
                       From="0.4" To="1.25" Duration="0:0:0.55" BeginTime="0:0:0.1">
        <DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="SparkleScale" Storyboard.TargetProperty="ScaleY"
                       From="0.4" To="1.25" Duration="0:0:0.55" BeginTime="0:0:0.1">
        <DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>

    <!-- 工作气泡 -->
    <Storyboard x:Key="Bubbles">
      <DoubleAnimation Storyboard.TargetName="Bub1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                       From="0" To="-38" Duration="0:0:3" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="Bub1" Storyboard.TargetProperty="Opacity"
                       From="0" To="0.55" Duration="0:0:0.6" AutoReverse="False" BeginTime="0:0:0"/>
      <DoubleAnimation Storyboard.TargetName="Bub2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                       From="0" To="-46" Duration="0:0:3.4" RepeatBehavior="Forever" BeginTime="0:0:1.1"/>
      <DoubleAnimation Storyboard.TargetName="Bub3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                       From="0" To="-34" Duration="0:0:2.7" RepeatBehavior="Forever" BeginTime="0:0:2.0"/>
    </Storyboard>

    <!-- 状态点呼吸 -->
    <Storyboard x:Key="DotPulse">
      <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity"
                       From="0.35" To="1" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
  </Window.Resources>

  <Grid x:Name="Root">
    <!-- 气泡 -->
    <Grid x:Name="BubbleHost" Width="348" HorizontalAlignment="Center" VerticalAlignment="Bottom"
          Margin="0,0,0,232" Opacity="1">
      <Grid.RenderTransform>
        <TranslateTransform x:Name="BubbleSlide"/>
      </Grid.RenderTransform>
      <Border x:Name="Bubble" CornerRadius="20" Padding="16,12,16,12"
              BorderBrush="#2EFFFFFF" BorderThickness="1"
              Effect="{StaticResource BubbleShadow}">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
            <GradientStop Color="#FA16213D" Offset="0"/>
            <GradientStop Color="#F20E1730" Offset="0.6"/>
            <GradientStop Color="#F20C142B" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <StackPanel>
          <DockPanel LastChildFill="True">
            <Grid DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,9,0" VerticalAlignment="Center">
              <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#7C93FF"/>
            </Grid>
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Margin="10,0,0,0" FontSize="11.5"
                       Foreground="#8FA3D9" VerticalAlignment="Center" Text=""/>
            <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold" Foreground="#F2F6FF"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text=""/>
          </DockPanel>
          <Border x:Name="BarTrack" Height="6" CornerRadius="3" Background="#22305C" Margin="0,10,0,0"
                  HorizontalAlignment="Stretch">
            <Border x:Name="BarFill" Width="0" CornerRadius="3" HorizontalAlignment="Left"
                    Background="{StaticResource BarBrush}"/>
          </Border>
          <TextBlock x:Name="TaskText" Margin="0,9,0,0" FontSize="12.5" Foreground="#D7E0FF"
                     TextTrimming="CharacterEllipsis" LineHeight="17" Text=""/>
          <TextBlock x:Name="MetaText" Margin="0,5,0,0" FontSize="10.5" Foreground="#7F90C4"
                     TextTrimming="CharacterEllipsis" Text=""/>
        </StackPanel>
      </Border>
      <Path x:Name="BubbleTail" Data="M 0 0 L 18 0 L 9 11 Z" Fill="#F2101932"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-10"/>
    </Grid>

    <!-- 小鱼 -->
    <Grid x:Name="FishHost" Width="260" Height="210" HorizontalAlignment="Center" VerticalAlignment="Bottom">
      <Grid.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="BaseScale" ScaleX="1.08" ScaleY="1.08" CenterX="130" CenterY="196"/>
          <ScaleTransform x:Name="JumpScale" ScaleX="1" ScaleY="1" CenterX="130" CenterY="196"/>
          <TranslateTransform x:Name="JumpY"/>
        </TransformGroup>
      </Grid.RenderTransform>

      <Canvas x:Name="FishCanvas" Width="260" Height="210">
        <Canvas.RenderTransform>
          <TranslateTransform x:Name="FishBob"/>
        </Canvas.RenderTransform>

        <!-- 地面投影 -->
        <Ellipse Canvas.Left="66" Canvas.Top="176" Width="150" Height="18" Fill="#000000" Opacity="0.16">
          <Ellipse.Effect><BlurEffect Radius="7"/></Ellipse.Effect>
        </Ellipse>

        <!-- 尾巴 -->
        <Path x:Name="Tail" Data="M 90 101 C 74 85 50 73 24 79 C 32 90 34 98 34 102 C 34 107 32 115 24 126 C 50 132 74 121 90 105 Z"
              Fill="{StaticResource TailBrush}">
          <Path.RenderTransform>
            <RotateTransform x:Name="TailRotate" CenterX="90" CenterY="104" Angle="0"/>
          </Path.RenderTransform>
        </Path>

        <!-- 背鳍 -->
        <Path Data="M 120 48 C 116 30 128 18 146 20 C 154 27 152 37 158 45 C 147 40 131 41 123 48 Z"
              Fill="{StaticResource FinBrush}"/>

        <!-- 身体 -->
        <Path x:Name="Body" Data="M 198 100 C 198 62 168 38 126 38 C 88 38 62 64 60 100 C 58 136 88 162 128 162 C 168 162 198 136 198 100 Z"
              Fill="{StaticResource BodyBrush}" Effect="{StaticResource FishShadow}"/>

        <!-- 肚子高光 -->
        <Path Data="M 80 128 C 92 153 118 164 144 158 C 168 152 181 136 181 126 C 161 143 131 149 105 141 C 93 137 85 132 80 128 Z"
              Fill="#FFFFFF" Opacity="0.17"/>

        <!-- 头顶高光 -->
        <Path Data="M 92 66 C 104 46 126 38 146 42 C 130 46 112 56 100 74 Z"
              Fill="#FFFFFF" Opacity="0.34">
          <Path.Effect><BlurEffect Radius="4"/></Path.Effect>
        </Path>

        <!-- 左眼 -->
        <Canvas x:Name="EyeL" Canvas.Left="120" Canvas.Top="68" Width="36" Height="36" RenderTransformOrigin="0.5,0.5">
          <Canvas.RenderTransform><ScaleTransform x:Name="EyeScaleL" ScaleY="1"/></Canvas.RenderTransform>
          <Ellipse Width="36" Height="36" Fill="#FFFFFF"/>
          <Ellipse Canvas.Left="10" Canvas.Top="10" Width="20" Height="20" Fill="#12234F"/>
          <Ellipse Canvas.Left="12" Canvas.Top="9" Width="8" Height="8" Fill="#FFFFFF"/>
          <Ellipse Canvas.Left="23" Canvas.Top="23" Width="4" Height="4" Fill="#FFFFFF" Opacity="0.7"/>
        </Canvas>

        <!-- 右眼 -->
        <Canvas x:Name="EyeR" Canvas.Left="164" Canvas.Top="78" Width="30" Height="30" RenderTransformOrigin="0.5,0.5">
          <Canvas.RenderTransform><ScaleTransform x:Name="EyeScaleR" ScaleY="1"/></Canvas.RenderTransform>
          <Ellipse Width="30" Height="30" Fill="#FFFFFF"/>
          <Ellipse Canvas.Left="8" Canvas.Top="8" Width="17" Height="17" Fill="#12234F"/>
          <Ellipse Canvas.Left="10" Canvas.Top="7" Width="7" Height="7" Fill="#FFFFFF"/>
          <Ellipse Canvas.Left="20" Canvas.Top="19" Width="3" Height="3" Fill="#FFFFFF" Opacity="0.7"/>
        </Canvas>

        <!-- 开心时的眯眯眼 -->
        <Canvas x:Name="HappyEyes" Opacity="0">
          <Path Data="M 122 89 C 128 78 148 78 154 89" Stroke="#12234F" StrokeThickness="4"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Path Data="M 168 97 C 173 89 187 89 192 97" Stroke="#12234F" StrokeThickness="3.6"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>

        <!-- 腮红 -->
        <Ellipse Canvas.Left="112" Canvas.Top="104" Width="26" Height="14" Fill="#FF9FBE" Opacity="0.5">
          <Ellipse.Effect><BlurEffect Radius="6"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse Canvas.Left="176" Canvas.Top="112" Width="18" Height="10" Fill="#FF9FBE" Opacity="0.45">
          <Ellipse.Effect><BlurEffect Radius="5"/></Ellipse.Effect>
        </Ellipse>

        <!-- 嘴 -->
        <Path x:Name="Mouth" Data="M 156 118 C 162 126 172 127 180 119"
              Stroke="#15265C" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
        <Path x:Name="HappyMouth" Data="M 152 114 C 158 128 178 128 184 114 C 173 123 163 123 152 114 Z"
              Fill="#7A1F3D" Stroke="#12234F" StrokeThickness="2" Opacity="0"/>

        <!-- 侧鳍 -->
        <Path Data="M 123 129 C 113 134 106 147 112 156 C 121 161 132 151 130 139 C 129 132 127 128 123 129 Z"
              Fill="{StaticResource TailBrush}" Opacity="0.95">
          <Path.RenderTransform>
            <RotateTransform x:Name="FinRotate" CenterX="118" CenterY="145" Angle="0"/>
          </Path.RenderTransform>
        </Path>

        <!-- 吐泡泡 -->
        <Ellipse x:Name="Bub1" Canvas.Left="198" Canvas.Top="66" Width="9" Height="9" Fill="#D5E1FF" Opacity="0.55">
          <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Bub2" Canvas.Left="208" Canvas.Top="44" Width="12" Height="12" Fill="#D5E1FF" Opacity="0.4">
          <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Bub3" Canvas.Left="200" Canvas.Top="26" Width="7" Height="7" Fill="#D5E1FF" Opacity="0.3">
          <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
        </Ellipse>

        <!-- 完成星光 -->
        <Canvas x:Name="SparkleLayer" Opacity="0" RenderTransformOrigin="0.5,0.5">
          <Canvas.RenderTransform><ScaleTransform x:Name="SparkleScale" ScaleX="1" ScaleY="1"/></Canvas.RenderTransform>
          <Path Canvas.Left="30" Canvas.Top="52" Width="18" Height="18" Stretch="Uniform"
                Data="M 8 0 L 10 6 L 16 8 L 10 10 L 8 16 L 6 10 L 0 8 L 6 6 Z" Fill="#FFD86B"/>
          <Path Canvas.Left="214" Canvas.Top="34" Width="14" Height="14" Stretch="Uniform"
                Data="M 8 0 L 10 6 L 16 8 L 10 10 L 8 16 L 6 10 L 0 8 L 6 6 Z" Fill="#FFE9A8"/>
          <Path Canvas.Left="18" Canvas.Top="140" Width="12" Height="12" Stretch="Uniform"
                Data="M 8 0 L 10 6 L 16 8 L 10 10 L 8 16 L 6 10 L 0 8 L 6 6 Z" Fill="#FFD86B"/>
          <Path Canvas.Left="226" Canvas.Top="132" Width="16" Height="16" Stretch="Uniform"
                Data="M 8 0 L 10 6 L 16 8 L 10 10 L 8 16 L 6 10 L 0 8 L 6 6 Z" Fill="#FFE9A8"/>
          <Ellipse Canvas.Left="48" Canvas.Top="28" Width="5" Height="5" Fill="#FFFFFF"/>
          <Ellipse Canvas.Left="206" Canvas.Top="96" Width="4" Height="4" Fill="#FFFFFF"/>
        </Canvas>

        <!-- 完成徽章 -->
        <Canvas x:Name="DoneBadge" Canvas.Left="188" Canvas.Top="150" Width="34" Height="34" Opacity="0">
          <Ellipse Width="34" Height="34" Fill="#3DDC97" Stroke="#FFFFFF" StrokeThickness="2"/>
          <Path Data="M 9 17 L 15 23 L 26 11" Stroke="#FFFFFF" StrokeThickness="3.4"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
      </Canvas>
    </Grid>
  </Grid>
</Window>
